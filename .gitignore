# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# IDE & editor directories
.idea/
.vscode/
*.swp
*.swo

# Antigravity dynamic links (rebuilt per workspace; tracked via .agent/.active-skills.json)
.agents/skills/*
!.agents/skills/.gitkeep

# Common language build & runtime artifacts
node_modules/
dist/
build/
__pycache__/
*.pyc
.venv/
target/

# Compiled binary output directories & root-anchored binaries (never unanchored globs)
/bin/
/server
/client
/cli
/app

# Local Wiki Knowledge Graph cache & artifacts
.wiki-cache.json
**/.wiki-cache.json
wiki/.wiki-cache.json
wiki-graph.json
wiki-graph.html
wiki-graph.dot
wiki-graph.mermaid

# Antigravity dynamic cluster leases & runtime state
.agents/.skill-leases.json
.agents/.turn-cache.json
*.active-skills.json.bak

# Competition video & agent scratch artifacts
DEMO_VIDEO_SCRIPT.md
demo-recording/
scratch/
personal/

# Local secrets & credentials
secrets/
*.json.key
*.pem

# Local state database & cache
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/

# Local agent rules & maintainer taste
.agents/rules/
wiki/repo-tastes/
repo-tastes/

# Large downloaded dataset files
datasets/*.fvecs
datasets/*.bvecs
datasets/*.tar.gz
datasets/*.parquet
datasets/*.h5
!datasets/README.md

# Dynamic benchmark execution traces
runs/
*.wal
!results/traces/.gitkeep
!results/traces/sample_*.wal
results/traces/benchmark.json


